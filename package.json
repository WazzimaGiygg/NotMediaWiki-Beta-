{
  "name": "notmediawiki",
  "version": "1.0.0",
  "type": "module",
  "description": "Next-generation distributed microservices architecture converting Wikimedia MediaWiki into high-scale Node.js services with Parsoid AST parser, EventStreams, and Firebase Firestore.",

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES (mantidas + melhoradas)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotBanned() {
      return isAuthenticated() && 
        !exists(/databases/$(database)/documents/bannedusers/$(request.auth.uid)) &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true);
    }

    function isRegistered() {
      return isAuthenticated() && isNotBanned();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/userpage/$(request.auth.uid)) ||
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/userpage/$(request.auth.uid)).data;
    }

    function hasExplicitReaderRole() {
      return userDocExists() &&
        getUserData().get('role', '') == 'reader';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'pedrohenriquecardonaperes@gmail.com',
          'pedrohenriquecaronaperes@gmail.com',
          'mafersao1100@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/userpage/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userpage/$(request.auth.uid)).data.get('email', '') in [
           'pedrohenriquecardonaperes@gmail.com',
           'pedrohenriquecaronaperes@gmail.com',
           'mafersao1100@gmail.com'
         ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') in [
           'pedrohenriquecardonaperes@gmail.com',
           'pedrohenriquecaronaperes@gmail.com',
           'mafersao1100@gmail.com'
         ])
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userDocExists() && (
          getUserData().get('group', '') in ['admin', 'administrador', 'superadmin', 'sysop', 'bureaucrat'] ||
          getUserData().get('role', '') in ['admin', 'administrador', 'superadmin', 'sysop', 'bureaucrat']
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        (isNotBanned() && userDocExists() && (
          getUserData().get('group', '') in ['moderator', 'moderador', 'admin', 'administrador', 'superadmin', 'sysop', 'bureaucrat'] ||
          getUserData().get('role', '') in ['moderator', 'moderador', 'admin', 'administrador', 'superadmin', 'sysop', 'bureaucrat']
        ))
      );
    }

    function isEditor() {
      return isRegistered() && !hasExplicitReaderRole();
    }

    function isBot() {
      return isRegistered() && 
        userDocExists() && 
        (getUserData().get('isBot', false) == true || 
         getUserData().get('botFlag', false) == true ||
         getUserData().get('group', '') == 'bot' || 
         getUserData().get('role', '') == 'bot');
    }

    function isPageProtected(data) {
      return data.get('isProtected', false) == true ||
        data.get('protectionLevel', '') in ['semi', 'full', 'sysop'];
    }

    function matchesRequestAuthor() {
      return request.resource.data.get('authorUid', '') == request.auth.uid ||
        ('author' in request.resource.data &&
         request.resource.data.author is map && (
           request.resource.data.author.get('id', '') == request.auth.uid ||
           request.resource.data.author.get('uid', '') == request.auth.uid
         ));
    }

    // ==========================================
    // PÁGINAS E HISTÓRICO (CORREÇÃO CRÍTICA)
    // ==========================================

    match /pages/{pageId} {
      // Leitura pública
      allow read: if true;

      // Criar página: editores, bots e administradores
      allow create: if (isEditor() || isAdmin() || isBot())
        && request.resource.data.keys().hasAll(['title', 'content', 'createdAt', 'authorUid'])
        && (request.resource.data.authorUid == request.auth.uid || isAdmin() || isBot())
        && (!isPageProtected(request.resource.data) || isModerator() || isBot())
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);

      // Atualizar página: qualquer editor em páginas desprotegidas + campos de auditoria preservados
      allow update: if (isEditor() || isAdmin() || isBot())
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdAt', 'authorUid', 'pageId'])
        )
        && (!isPageProtected(resource.data) || isModerator() || isBot())
        && (!isPageProtected(request.resource.data) || isModerator() || isBot());

      // Deletar: admin ou moderador
      allow delete: if isAdmin() || isModerator();

      // ========== HISTÓRICO (VERSIONS) - IMUTÁVEL ==========
      match /versions/{versionId} {
        // Leitura pública (necessário para histórico)
        allow read: if true;

        // Só pode CRIAR uma nova versão (nunca atualizar ou deletar)
        allow create: if (isEditor() || isAdmin() || isBot())
          && request.resource.data.keys().hasAll([
            'content', 'authorUid', 'timestamp', 'versionNumber', 'pageId'
          ])
          && (request.resource.data.authorUid == request.auth.uid || isAdmin() || isBot())
          && (request.resource.data.timestamp is timestamp || request.resource.data.timestamp is string)
          && request.resource.data.pageId == pageId;

        // PROIBIDO atualizar ou deletar versões (imutabilidade)
        allow update, delete: if false;
      }
    }

    // ==========================================
    // ARTICLES (colaboração livre para editores em páginas desprotegidas)
    // ==========================================
    match /articles/{articleId} {
      allow read: if true;

      allow create: if (isEditor() || isAdmin() || isBot())
        && (
          !('authorUid' in request.resource.data) ||
          request.resource.data.authorUid == request.auth.uid ||
          matchesRequestAuthor() ||
          isAdmin() ||
          isBot()
        )
        && (!isPageProtected(request.resource.data) || isModerator() || isBot())
        && (
          !('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp ||
          request.resource.data.createdAt is string
        );

      allow update: if (isEditor() || isAdmin() || isBot())
        && (!isPageProtected(resource.data) || isModerator() || isBot())
        && (!isPageProtected(request.resource.data) || isModerator() || isBot());

      allow delete: if isAdmin() || isModerator();

      // Subcoleções de histórico em articles (imutáveis)
      match /revisions/{revisionId} {
        allow read: if true;
        allow create: if (isEditor() || isAdmin() || isBot())
          && (matchesRequestAuthor() || isAdmin() || isBot());
        allow update, delete: if false;
      }

      match /versions/{versionId} {
        allow read: if true;
        allow create: if (isEditor() || isAdmin() || isBot())
          && (matchesRequestAuthor() || isAdmin() || isBot());
        allow update, delete: if false;
      }
    }

    // ==========================================
    // REVISÕES & VERSÕES RAIZ (Append-Only)
    // ==========================================
    match /revisions/{revisionId} {
      allow read: if true;
      allow create: if (isEditor() || isAdmin() || isBot())
        && (matchesRequestAuthor() || isAdmin() || isBot());
      allow update, delete: if false;
    }

    match /versions/{versionId} {
      allow read: if true;
      allow create: if (isEditor() || isAdmin() || isBot())
        && (matchesRequestAuthor() || isAdmin() || isBot());
      allow update, delete: if false;
    }

    // ==========================================
    // COLEÇÕES SENSÍVEIS (corrigidas)
    // ==========================================

    // Extensões: só admin pode escrever
    match /wiki_extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_extension_registry/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_extension_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isRegistered();
      allow update, delete: if isAdmin();
    }

    function isValidWikiExtension(data, extensionId) {
      return data.keys().hasOnly([
          'id', 'name', 'namePt', 'version', 'category', 'author', 'description',
          'enabled', 'type', 'url', 'license', 'hooks', 'config', 'manifestJson',
          'lastUpdated', 'updatedBy', 'updatedByRole', 'updatedAt'
        ])
        && data.keys().hasAll(['id', 'name', 'enabled', 'category'])
        && data.id is string && data.id == extensionId && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.enabled is bool
        && data.category in ['parser', 'ui', 'search', 'security', 'infra', 'media', 'engagement']
        && (!('namePt' in data) || (data.namePt is string && data.namePt.size() <= 255))
        && (!('version' in data) || (data.version is string && data.version.size() <= 64))
        && (!('author' in data) || (data.author is string && data.author.size() <= 255))
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('type' in data) || data.type in ['extension', 'skin', 'service'])
        && (!('url' in data) || (data.url is string && data.url.size() <= 500))
        && (!('license' in data) || (data.license is string && data.license.size() <= 64))
        && (!('hooks' in data) || data.hooks is list)
        && (!('config' in data) || data.config is list)
        && (!('manifestJson' in data) || data.manifestJson is map)
        && (!('lastUpdated' in data) || (data.lastUpdated is string && data.lastUpdated.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && (!('updatedByRole' in data) || (data.updatedByRole is string && data.updatedByRole.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /extensions/{extensionId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidWikiExtension(request.resource.data, extensionId);
      allow delete: if isAdmin();
    }

    // Telemetria: só sistema/admin
    match /system_telemetry/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isBot();
    }

    match /telemetry/{telemetryId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isBot();
    }

    // Audit logs: criar permitido, mas nunca atualizar/deletar
    match /audit_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isRegistered();
      allow update, delete: if false; // Imutável
    }

    match /system_logs/{logId} {
      allow read: if isAdmin() || isEditor();
      allow create: if isRegistered();
      allow update, delete: if isAdmin();
    }

    match /sync_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin() || isBot();
    }

    // ==========================================
    // USUÁRIOS, GOVERNANÇA & BOTS
    // ==========================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
        && (!('isBot' in request.resource.data) || request.resource.data.isBot == false || isAdmin())
        && (!('group' in request.resource.data) || isAdmin())
        && (!('role' in request.resource.data) || request.resource.data.role == 'editor' || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) && isNotBanned() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'isBot', 'group'])
        )
      );
      allow delete: if isAdmin();
    }

    match /userpage/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (isOwner(userId) && isNotBanned());
    }

    match /user_pages/{pageId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isRegistered() &&
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isEditor() && (
          (resource.data.userId == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'role'])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['talkPosts', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() || (isRegistered() && resource.data.userId == request.auth.uid);
    }

    match /bannedusers/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /allowed_domains/{domainId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_events/{eventId} {
      allow read: if true;
      allow create: if isEditor() || isAdmin() || isBot();
      allow update, delete: if false;
    }

    // Bots e Automação
    match /bot_agents_config/{botId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bot_users/{botUserId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bot_activity_logs/{logId} {
      allow read: if true;
      allow create: if isRegistered() && (isAdmin() || isBot());
      allow update, delete: if isAdmin();
    }

    match /user_abuse_audits/{auditId} {
      allow read: if isAdmin() || (isAuthenticated() && auditId == request.auth.uid);
      allow create, update: if isAdmin() || isBot();
      allow delete: if isAdmin();
    }

    // Casos jurídicos e moderação
    match /checkuser_investigations/{caseId} {
      allow read, write: if isAdmin();
    }

    match /vpn_detections/{detectionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /compliance_records/{recordId} {
      allow read, write: if isAdmin();
    }

    match /arbitration_cases/{caseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.requesterId == request.auth.uid);
      allow create: if isRegistered() && request.resource.data.requesterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /blp_ethics_cases/{caseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isRegistered() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /data_removals/{removalId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /emergency_reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /unblock_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    function isValidChatId(id) {
      return id is string && id.size() > 0 && id.size() <= 280 && id.matches('^[a-zA-Z0-9_.:\\-]+$');
    }

    function isValidDirectChat(data, chatId) {
      return data.keys().hasOnly([
          'id', 'participants', 'participantNames', 'participantAvatars',
          'participantTags', 'lastMessage', 'lastMessageAt',
          'lastMessageSenderId', 'unreadCount', 'createdAt'
        ])
        && data.keys().hasAll(['id', 'participants', 'createdAt'])
        && data.id is string && data.id == chatId && data.id.size() > 0 && data.id.size() <= 280
        && data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 10
        && data.participants[0] is string
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 64
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 4000))
        && (!('lastMessageAt' in data) || (data.lastMessageAt is string && data.lastMessageAt.size() <= 64))
        && (!('lastMessageSenderId' in data) || (data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128))
        && (!('participantNames' in data) || data.participantNames is map)
        && (!('participantAvatars' in data) || data.participantAvatars is map)
        && (!('participantTags' in data) || data.participantTags is map)
        && (!('unreadCount' in data) || data.unreadCount is map);
    }

    function isValidChatMessage(data, messageId, chatId) {
      return data.keys().hasOnly([
          'id', 'chatId', 'senderId', 'senderUsername', 'senderTag',
          'senderAvatar', 'senderRole', 'text', 'timestamp', 'read'
        ])
        && data.keys().hasAll(['id', 'chatId', 'senderId', 'senderUsername', 'text', 'timestamp'])
        && data.id is string && data.id == messageId && data.id.size() > 0 && data.id.size() <= 128
        && data.chatId is string && data.chatId == chatId && data.chatId.size() > 0 && data.chatId.size() <= 280
        && data.senderId is string && data.senderId == request.auth.uid && data.senderId.size() <= 128
        && data.senderUsername is string && data.senderUsername.size() > 0 && data.senderUsername.size() <= 255
        && (!('senderTag' in data) || (data.senderTag is string && data.senderTag.size() <= 32))
        && (!('senderAvatar' in data) || (data.senderAvatar is string && data.senderAvatar.size() <= 64))
        && (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 64))
        && data.text is string && data.text.size() > 0 && data.text.size() <= 4000
        && data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 64
        && (!('read' in data) || data.read is bool);
    }

    function isDirectChatParticipant(chatId) {
      return exists(/databases/$(database)/documents/direct_chats/$(chatId)) &&
        'participants' in get(/databases/$(database)/documents/direct_chats/$(chatId)).data &&
        get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants is list &&
        request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants;
    }

    match /direct_chats/{chatId} {
      allow get: if isAuthenticated() && isValidChatId(chatId) && (
        isAdmin() ||
        resource == null ||
        ('participants' in resource.data && resource.data.participants is list && request.auth.uid in resource.data.participants)
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid in resource.data.participants
      );
      allow create: if isRegistered() && isValidChatId(chatId)
        && isValidDirectChat(request.resource.data, chatId)
        && request.auth.uid in request.resource.data.participants;
      allow update: if isRegistered() && isValidChatId(chatId) && (
        isAdmin() || (
          'participants' in resource.data &&
          resource.data.participants is list &&
          request.auth.uid in resource.data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageAt', 'lastMessageSenderId',
            'unreadCount', 'participantNames', 'participantAvatars', 'participantTags'
          ]) &&
          (!('lastMessage' in request.resource.data) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 4000)) &&
          (!('lastMessageAt' in request.resource.data) || (request.resource.data.lastMessageAt is string && request.resource.data.lastMessageAt.size() <= 64)) &&
          (!('lastMessageSenderId' in request.resource.data) || (request.resource.data.lastMessageSenderId is string && request.resource.data.lastMessageSenderId == request.auth.uid))
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get: if isAuthenticated() && isValidChatId(chatId) && isValidChatId(messageId) && (
          isAdmin() ||
          isDirectChatParticipant(chatId)
        );
        allow list: if isAuthenticated() && isValidChatId(chatId) && (
          isAdmin() ||
          isDirectChatParticipant(chatId)
        );
        allow create: if isRegistered() && isValidChatId(chatId) && isValidChatId(messageId)
          && isValidChatMessage(request.resource.data, messageId, chatId)
          && (isAdmin() || isDirectChatParticipant(chatId));
        allow update: if isRegistered() && isValidChatId(chatId) && isValidChatId(messageId) && (
          isAdmin() || (
            isDirectChatParticipant(chatId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
            request.resource.data.read is bool
          )
        );
        allow delete: if isAdmin();
      }
    }

    match /user_daily_checklists/{checklistId} {
      allow read: if true;
      allow create: if isAdmin() || (isRegistered() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isRegistered() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    match /user_monthly_points/{ledgerId} {
      allow read: if true;
      allow create: if isAdmin() || (isRegistered() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isRegistered() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isAdmin();
    }

    match /article_ratings/{ratingId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /article_votes/{voteId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update: if isRegistered() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /watchlist_subscriptions/{subId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /article_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isRegistered();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    match /fcm_tokens/{tokenId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update: if isRegistered() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    function isValidArticleDraft(data) {
      return data.keys().hasOnly([
          'id', 'userId', 'articleSlug', 'title', 'wikitext', 'summary', 'isMinor', 'updatedAt'
        ])
        && data.keys().hasAll(['id', 'userId', 'articleSlug', 'title', 'wikitext', 'updatedAt'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 256
        && data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128
        && data.articleSlug is string && data.articleSlug.size() > 0 && data.articleSlug.size() <= 255
        && data.title is string && data.title.size() <= 255
        && data.wikitext is string && data.wikitext.size() <= 500000
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000))
        && (!('isMinor' in data) || data.isMinor is bool)
        && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64;
    }

    match /article_drafts/{draftId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isRegistered()
        && isValidArticleDraft(request.resource.data)
        && request.resource.data.id == draftId;
      allow update: if isRegistered()
        && resource.data.userId == request.auth.uid
        && isValidArticleDraft(request.resource.data)
        && request.resource.data.id == draftId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES (mantidas + melhoradas)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isNotBanned() {
      return isAuthenticated() && 
        !exists(/databases/$(database)/documents/bannedusers/$(request.auth.uid)) &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true);
    }

    function isRegistered() {
      return isAuthenticated() && isNotBanned();
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/userpage/$(request.auth.uid)) ||
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/userpage/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userpage/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in [
          'pedrohenriquecardonaperes@gmail.com',
          'pedrohenriquecaronaperes@gmail.com',
          'mafersao1100@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/userpage/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userpage/$(request.auth.uid)).data.get('email', '') in [
           'pedrohenriquecardonaperes@gmail.com',
           'pedrohenriquecaronaperes@gmail.com',
           'mafersao1100@gmail.com'
         ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') in [
           'pedrohenriquecardonaperes@gmail.com',
           'pedrohenriquecaronaperes@gmail.com',
           'mafersao1100@gmail.com'
         ])
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (userDocExists() && (
          getUserData().get('group', '') in ['admin', 'administrador', 'superadmin', 'sysop', 'bureaucrat'] ||
          getUserData().get('role', '') in ['admin', 'administrador', 'superadmin', 'sysop', 'bureaucrat']
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isEditor() {
      return isRegistered() && (
        isAdmin() ||
        (userDocExists() && (
          getUserData().get('group', '') in ['editor', 'admin', 'moderador', 'administrador'] ||
          getUserData().get('role', '') in ['editor', 'moderador', 'admin', 'administrador']
        ))
      );
    }

    function isBot() {
      return isRegistered() && 
        userDocExists() && 
        (getUserData().get('isBot', false) == true || 
         getUserData().get('botFlag', false) == true ||
         getUserData().get('group', '') == 'bot' || 
         getUserData().get('role', '') == 'bot');
    }

    // ==========================================
    // PÁGINAS E HISTÓRICO (CORREÇÃO CRÍTICA)
    // ==========================================

    match /pages/{pageId} {
      // Leitura pública
      allow read: if true;

      // Criar página: apenas usuários registrados
      allow create: if isRegistered()
        && request.resource.data.keys().hasAll(['title', 'content', 'createdAt', 'authorUid'])
        && (request.resource.data.authorUid == request.auth.uid || isAdmin() || isBot())
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);

      // Atualizar página: apenas se não estiver protegida + campos de auditoria preservados
      allow update: if isRegistered()
        && (
          // Não pode alterar campos de auditoria
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdAt', 'authorUid', 'pageId'])
        )
        && (
          // Se a página estiver protegida, só admin/editor
          !(resource.data.get('protectionLevel', '') in ['semi', 'full', 'sysop']) 
          || isEditor()
        );

      // Deletar: só admin
      allow delete: if isAdmin();

      // ========== HISTÓRICO (VERSIONS) - IMUTÁVEL ==========
      match /versions/{versionId} {
        // Leitura pública (necessário para histórico)
        allow read: if true;

        // Só pode CRIAR uma nova versão (nunca atualizar ou deletar)
        allow create: if isRegistered()
          && !exists(/databases/$(database)/documents/pages/$(pageId)/versions/$(versionId))
          && request.resource.data.keys().hasAll([
            'content', 'authorUid', 'timestamp', 'versionNumber', 'pageId'
          ])
          && (request.resource.data.authorUid == request.auth.uid || isAdmin() || isBot())
          && (request.resource.data.timestamp is timestamp || request.resource.data.timestamp is string)
          && request.resource.data.pageId == pageId;

        // PROIBIDO atualizar ou deletar versões (imutabilidade)
        allow update, delete: if false;
      }
    }

    // ==========================================
    // ARTICLES (mesma lógica de imutabilidade)
    // ==========================================
    match /articles/{articleId} {
      allow read: if true;

      allow create: if isRegistered()
        && (
          request.resource.data.get('authorUid', request.auth.uid) == request.auth.uid ||
          (request.resource.data.author.id == request.auth.uid) ||
          isAdmin() ||
          isBot()
        )
        && (
          !('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp ||
          request.resource.data.createdAt is string
        );

      allow update: if isRegistered()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['slug'])
        && (
          !(resource.data.get('protectionLevel', '') in ['semi', 'full', 'sysop']) &&
          resource.data.get('isProtected', false) != true
          || isEditor()
        );

      allow delete: if isAdmin();

      // Subcoleções de histórico em articles (imutáveis)
      match /revisions/{revisionId} {
        allow read: if true;
        allow create: if isRegistered()
          && !exists(/databases/$(database)/documents/articles/$(articleId)/revisions/$(revisionId))
          && (
            request.resource.data.author.id == request.auth.uid ||
            request.resource.data.get('authorUid', '') == request.auth.uid ||
            isAdmin() ||
            isBot()
          );
        allow update, delete: if false;
      }

      match /versions/{versionId} {
        allow read: if true;
        allow create: if isRegistered()
          && !exists(/databases/$(database)/documents/articles/$(articleId)/versions/$(versionId))
          && (
            request.resource.data.author.id == request.auth.uid ||
            request.resource.data.get('authorUid', '') == request.auth.uid ||
            isAdmin() ||
            isBot()
          );
        allow update, delete: if false;
      }
    }

    // ==========================================
    // REVISÕES & VERSÕES RAIZ (Append-Only)
    // ==========================================
    match /revisions/{revisionId} {
      allow read: if true;
      allow create: if isRegistered()
        && !exists(/databases/$(database)/documents/revisions/$(revisionId))
        && (request.resource.data.author.id == request.auth.uid || isAdmin() || isBot());
      allow update, delete: if false;
    }

    match /versions/{versionId} {
      allow read: if true;
      allow create: if isRegistered()
        && !exists(/databases/$(database)/documents/versions/$(versionId))
        && (
          request.resource.data.author.id == request.auth.uid ||
          request.resource.data.get('authorUid', '') == request.auth.uid ||
          isAdmin() ||
          isBot()
        );
      allow update, delete: if false;
    }

    // ==========================================
    // COLEÇÕES SENSÍVEIS (corrigidas)
    // ==========================================

    // Extensões: só admin pode escrever
    match /wiki_extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_extension_registry/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_extension_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isRegistered();
      allow update, delete: if isAdmin();
    }

    match /extensions/{extensionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Telemetria: só sistema/admin
    match /system_telemetry/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isBot();
    }

    match /telemetry/{telemetryId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isBot();
    }

    // Audit logs: criar permitido, mas nunca atualizar/deletar
    match /audit_logs/{logId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isRegistered();
      allow update, delete: if false; // Imutável
    }

    match /system_logs/{logId} {
      allow read: if isAdmin() || isEditor();
      allow create: if isRegistered();
      allow update, delete: if isAdmin();
    }

    match /sync_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin() || isBot();
    }

    // ==========================================
    // USUÁRIOS, GOVERNANÇA & BOTS
    // ==========================================

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId
        && (!('isBanned' in request.resource.data) || request.resource.data.isBanned == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'editor' || isAdmin());
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) && isNotBanned() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBanned', 'isBot'])
        )
      );
      allow delete: if isAdmin();
    }

    match /userpage/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (isOwner(userId) && isNotBanned());
    }

    match /user_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);
    }

    match /bannedusers/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /allowed_domains/{domainId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_metadata/{metaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wiki_events/{eventId} {
      allow read: if true;
      allow create: if isRegistered() && !exists(/databases/$(database)/documents/wiki_events/$(eventId));
      allow update, delete: if false;
    }

    // Bots e Automação
    match /bot_agents_config/{botId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bot_users/{botUserId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bot_activity_logs/{logId} {
      allow read: if true;
      allow create: if isRegistered() && (isAdmin() || isBot());
      allow update, delete: if isAdmin();
    }

    match /user_abuse_audits/{auditId} {
      allow read: if isAdmin() || (isAuthenticated() && auditId == request.auth.uid);
      allow create, update: if isAdmin() || isBot();
      allow delete: if isAdmin();
    }

    // Casos jurídicos e moderação
    match /checkuser_investigations/{caseId} {
      allow read, write: if isAdmin();
    }

    match /vpn_detections/{detectionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /compliance_records/{recordId} {
      allow read, write: if isAdmin();
    }

    match /arbitration_cases/{caseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.requesterId == request.auth.uid);
      allow create: if isRegistered() && request.resource.data.requesterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /blp_ethics_cases/{caseId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isRegistered() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /data_removals/{removalId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /emergency_reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /unblock_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /direct_chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isRegistered() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(chatId)).data.participants ||
          isAdmin()
        );
      }
    }

    match /user_daily_checklists/{checklistId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    match /user_monthly_points/{ledgerId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
    }

    match /article_ratings/{ratingId} {
      allow read: if true;
      allow create: if isRegistered() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
